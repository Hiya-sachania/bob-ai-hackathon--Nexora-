# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai (if used)
Not currently used.
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Database (if used)
Not currently used. The project uses in-memory synthetic data.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Application
APP_PORT=8000
APP_ENV=development

# Notifications (optional)
Not currently used.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Add your project-specific variables below
No additional environment variables are required for this project.
The project runs using synthetic data in the browser.
